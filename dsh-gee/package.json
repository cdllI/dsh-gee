{
  "name": "@local/dsh-gee",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Google Earth Engine capability bundle for DeepSeek Harness",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "worker.py",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "vendor/*",
    "skill.md",
    "setup.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
